{
  "name": "@blockexpanse/affine-widget-scroll-anchoring",
  "version": "1.0.2",
  "description": "Scroll anchoring widget for BlockExpanse editors.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alan-Cusack/blockexpanse.git",
    "directory": "packages/affine/widget-scroll-anchoring"
  },
  "scripts": {
    "build": "yarn run -T tsc",
    "test:unit": "yarn run -T nx vite:test --run --passWithNoTests",
    "test:unit:coverage": "yarn run -T nx vite:test --run --coverage",
    "test:e2e": "yarn run -T playwright test"
  },
  "sideEffects": false,
  "keywords": [],
  "author": "BlockExpanse Contributors",
  "license": "MPL-2.0",
  "dependencies": {
    "@blockexpanse/affine-model": "workspace:*",
    "@blockexpanse/affine-shared": "workspace:*",
    "@blockexpanse/block-std": "workspace:*",
    "@blockexpanse/global": "workspace:*",
    "@blockexpanse/theme": "workspace:*",
    "@preact/signals-core": "^1.8.0",
    "lit": "^3.2.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./effects": "./src/effects.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./effects": {
        "import": "./dist/effects.js",
        "types": "./dist/effects.d.ts"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "!src/__tests__",
    "!dist/__tests__"
  ]
}

{
  "name": "@blockexpanse/affine-shared",
  "version": "1.0.2",
  "description": "Shared services, themes, types, and utilities for BlockExpanse.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alan-Cusack/blockexpanse.git",
    "directory": "packages/affine/shared"
  },
  "scripts": {
    "build": "yarn run -T tsc",
    "test:unit": "yarn run -T nx vite:test --run",
    "test:unit:coverage": "yarn run -T nx vite:test --run --coverage",
    "test:e2e": "yarn run -T playwright test"
  },
  "sideEffects": false,
  "keywords": [],
  "author": "BlockExpanse Contributors",
  "license": "MPL-2.0",
  "dependencies": {
    "@blockexpanse/affine-model": "workspace:*",
    "@blockexpanse/block-std": "workspace:*",
    "@blockexpanse/global": "workspace:*",
    "@blockexpanse/icons": "workspace:*",
    "@blockexpanse/inline": "workspace:*",
    "@blockexpanse/store": "workspace:*",
    "@blockexpanse/theme": "workspace:*",
    "@floating-ui/dom": "^1.6.10",
    "@lit/context": "^1.1.2",
    "@preact/signals-core": "^1.8.0",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "lit": "^3.2.0",
    "lodash.clonedeep": "^4.5.0",
    "lodash.mergewith": "^4.6.2",
    "minimatch": "^10.0.1",
    "zod": "^3.23.8"
  },
  "exports": {
    ".": "./src/index.ts",
    "./selection": "./src/selection/index.ts",
    "./utils": "./src/utils/index.ts",
    "./consts": "./src/consts/index.ts",
    "./types": "./src/types/index.ts",
    "./commands": "./src/commands/index.ts",
    "./mixins": "./src/mixins/index.ts",
    "./theme": "./src/theme/index.ts",
    "./styles": "./src/styles/index.ts",
    "./services": "./src/services/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./adapters": "./src/adapters/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./selection": {
        "types": "./dist/selection/index.d.ts",
        "import": "./dist/selection/index.js"
      },
      "./utils": {
        "types": "./dist/utils/index.d.ts",
        "import": "./dist/utils/index.js"
      },
      "./consts": {
        "types": "./dist/consts/index.d.ts",
        "import": "./dist/consts/index.js"
      },
      "./types": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/types/index.js"
      },
      "./commands": {
        "types": "./dist/commands/index.d.ts",
        "import": "./dist/commands/index.js"
      },
      "./mixins": {
        "types": "./dist/mixins/index.d.ts",
        "import": "./dist/mixins/index.js"
      },
      "./theme": {
        "types": "./dist/theme/index.d.ts",
        "import": "./dist/theme/index.js"
      },
      "./styles": {
        "types": "./dist/styles/index.d.ts",
        "import": "./dist/styles/index.js"
      },
      "./services": {
        "types": "./dist/services/index.d.ts",
        "import": "./dist/services/index.js"
      },
      "./i18n": {
        "types": "./dist/i18n/index.d.ts",
        "import": "./dist/i18n/index.js"
      },
      "./adapters": {
        "types": "./dist/adapters/index.d.ts",
        "import": "./dist/adapters/index.js"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "!src/__tests__",
    "!dist/__tests__"
  ],
  "devDependencies": {
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/lodash.mergewith": "^4"
  }
}

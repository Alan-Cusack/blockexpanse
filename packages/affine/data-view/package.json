{
  "name": "@blockexpanse/data-view",
  "version": "1.0.2",
  "description": "Database views and data-view infrastructure for BlockExpanse.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alan-Cusack/blockexpanse.git",
    "directory": "packages/affine/data-view"
  },
  "scripts": {
    "build": "yarn run -T tsc",
    "test:unit": "yarn run -T nx vite:test --run --passWithNoTests",
    "test:unit:coverage": "yarn run -T nx vite:test --run --coverage",
    "test:e2e": "yarn run -T playwright test"
  },
  "sideEffects": false,
  "keywords": [],
  "author": "BlockExpanse Contributors",
  "license": "MPL-2.0",
  "dependencies": {
    "@blockexpanse/affine-components": "workspace:*",
    "@blockexpanse/affine-shared": "workspace:*",
    "@blockexpanse/block-std": "workspace:*",
    "@blockexpanse/global": "workspace:*",
    "@blockexpanse/icons": "workspace:*",
    "@blockexpanse/store": "workspace:*",
    "@blockexpanse/theme": "workspace:*",
    "@emotion/hash": "^0.9.2",
    "@floating-ui/dom": "^1.6.10",
    "@lit/context": "^1.1.2",
    "@preact/signals-core": "^1.8.0",
    "date-fns": "^4.0.0",
    "lit": "^3.2.0",
    "zod": "^3.23.8"
  },
  "exports": {
    ".": "./src/index.ts",
    "./property-presets": "./src/property-presets/index.ts",
    "./property-pure-presets": "./src/property-presets/pure-index.ts",
    "./view-presets": "./src/view-presets/index.ts",
    "./widget-presets": "./src/widget-presets/index.ts",
    "./effects": "./src/effects.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./property-presets": {
        "import": "./dist/property-presets/index.js",
        "types": "./dist/property-presets/index.d.ts"
      },
      "./property-pure-presets": {
        "import": "./dist/property-presets/pure-index.js",
        "types": "./dist/property-presets/pure-index.d.ts"
      },
      "./view-presets": {
        "import": "./dist/view-presets/index.js",
        "types": "./dist/view-presets/index.d.ts"
      },
      "./widget-presets": {
        "import": "./dist/widget-presets/index.js",
        "types": "./dist/widget-presets/index.d.ts"
      },
      "./effects": {
        "import": "./dist/effects.js",
        "types": "./dist/effects.d.ts"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "!src/__tests__",
    "!dist/__tests__"
  ]
}

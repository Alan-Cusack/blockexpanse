    "@types/mdast": "^4.0.4",
    "collapse-white-space": "^2.1.0",
    "date-fns": "^4.0.0",
    "dompurify": "^3.1.6",
    "fflate": "^0.8.2",
    "file-type": "^19.5.0",
    "fractional-indexing": "^3.2.0",
    "html2canvas": "^1.4.1",
    "katex": "^0.16.11",
    "lit": "^3.2.0",
    "lz-string": "^1.5.0",
    "mdast-util-gfm-autolink-literal": "^2.0.1",
    "mdast-util-gfm-strikethrough": "^2.0.0",

    "@blockexpanse/affine-block-surface": "workspace:*",
    "@blockexpanse/affine-components": "workspace:*",
    "@blockexpanse/affine-model": "workspace:*",
    "@blockexpanse/affine-shared": "workspace:*",
    "@blockexpanse/affine-widget-scroll-anchoring": "workspace:*",
    "@blockexpanse/block-std": "workspace:*",
    "@blockexpanse/data-view": "workspace:*",
    "@blockexpanse/global": "workspace:*",
    "@blockexpanse/icons": "workspace:*",
    "@blockexpanse/inline": "workspace:*",

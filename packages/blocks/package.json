  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas.ts",
    "./effects": "./src/effects.ts",
    "./widgets/slash-menu": "./src/root-block/widgets/slash-menu/index.ts",
    "./widgets/slash-menu/config": "./src/root-block/widgets/slash-menu/config.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./schemas": {
        "types": "./dist/schemas.d.ts",
        "import": "./dist/schemas.js"
      },
      "./effects": {
        "types": "./dist/effects.d.ts",
        "import": "./dist/effects.js"
      },
      "./widgets/slash-menu": {
        "types": "./dist/root-block/widgets/slash-menu/index.d.ts",
        "import": "./dist/root-block/widgets/slash-menu/index.js"
      },
      "./widgets/slash-menu/config": {
        "types": "./dist/root-block/widgets/slash-menu/config.d.ts",
        "import": "./dist/root-block/widgets/slash-menu/config.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.7"

{
  "name": "@blockexpanse/blocks",
  "version": "1.0.1",
  "description": "Default BlockExpanse editable blocks.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alan-Cusack/blockexpanse.git",
    "directory": "packages/blocks"
  },
  "scripts": {
    "build": "yarn run -T tsc",
    "test:unit": "yarn run -T nx vite:test --run",
    "test:unit:coverage": "yarn run -T nx vite:test --run --coverage",
    "test:e2e": "yarn run -T playwright test",
    "test": "yarn test:unit && yarn test:e2e"
  },
  "sideEffects": false,
  "keywords": [],
  "author": "BlockExpanse Contributors",
  "license": "MPL-2.0",
  "dependencies": {
    "@blockexpanse/affine-block-embed": "workspace:*",

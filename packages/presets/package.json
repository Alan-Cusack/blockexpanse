{
  "name": "@blockexpanse/presets",
  "version": "1.0.2",
  "description": "Prebuilt BlockExpanse editors and opt-in additional UI components.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alan-Cusack/blockexpanse.git",
    "directory": "packages/presets"
  },
  "scripts": {
    "build": "yarn run -T tsc",
    "test:unit": "yarn run -T nx vite:test --browser.headless --run",
    "test:debug": "PWDEBUG=1 yarn run -T vitest"
  },
  "sideEffects": false,
  "keywords": [],
  "author": "BlockExpanse Contributors",
  "license": "MPL-2.0",
  "dependencies": {
    "@blockexpanse/affine-block-surface": "workspace:*",
    "@blockexpanse/affine-model": "workspace:*",
    "@blockexpanse/affine-shared": "workspace:*",
    "@blockexpanse/block-std": "workspace:*",
    "@blockexpanse/blocks": "workspace:*",
    "@blockexpanse/global": "workspace:*",
    "@blockexpanse/inline": "workspace:*",
    "@blockexpanse/store": "workspace:*",
    "@blockexpanse/sync": "workspace:*",
    "@blockexpanse/sync-websocket": "workspace:*",
    "@blockexpanse/theme": "workspace:*",
    "@floating-ui/dom": "^1.6.10",
    "@lottiefiles/dotlottie-wc": "^0.4.0",
    "@preact/signals-core": "^1.8.0",
    "lit": "^3.2.0",
    "zod": "^3.23.8"
  },
  "exports": {
    ".": "./src/index.ts",
    "./effects": "./src/effects.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "module": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./effects": {
        "module": "./dist/effects.js",
        "types": "./dist/effects.d.ts",
        "import": "./dist/effects.js"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "themes",
    "!src/__tests__",
    "!dist/__tests__"
  ]
}
